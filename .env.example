# ==============================================================================
# TradeZen Environment Configuration Template
# Copy this file to '.env' and adjust the values for your local environment:
#   Windows: copy .env.example .env
#   Mac/Linux: cp .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/YOUR_DB_NAME

# Directory containing 1-minute historical equity CSVs (Data or data)
DATA_DIR=Data

# Default Paper Trader User ID
DEFAULT_USER_ID=1

# Environment mode: development | production | testing
ENVIRONMENT=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional Upstox Live Mode Configuration (Market Data Feed V3)
# Leave blank to run TradeZen in Historical Replay Mode (default)
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_VERSION=3.0

# Frontend Environment Variables (optional, defaults to localhost:8000)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
